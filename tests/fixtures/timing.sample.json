  "sentences": [
    {
      "id": "S01",
      "start": 0,
      "end": 7.16,
      "dur": 7.16,
      "text": "Before Rome ruled an empire, another army marched into the city and nearly destroyed it.",
      "confidence": 0.983
    },
    {
      "id": "S02",
      "start": 7.9,
      "end": 17.56,
      "dur": 9.66,
      "text": "In 390 BCE, a Gallic army under Brennus defeated the Romans at the Allia River, just a short distance from Rome.",
      "confidence": 0.947
    },
    {
      "id": "S03",
      "start": 18.48,
      "end": 19.86,
      "dur": 1.38,
      "text": "The defeat was catastrophic.",
      "confidence": 0.998
    },
    {
      "id": "S04",
      "start": 20.7,
      "end": 24.2,
      "dur": 3.5,
      "text": "The Roman army broke and the road to the city was open.",
      "confidence": 0.97
    },
    {
      "id": "S05",
      "start": 25,
      "end": 29.4,
      "dur": 4.4,
      "text": "With no army left to stop them, the Romans fled toward Rome.",
      "confidence": 0.996
    },
    {
      "id": "S06",
      "start": 30.2,
      "end": 38.48,
      "dur": 8.28,
      "text": "Some escaped into the countryside, others crowded into the strongest position they still had, the Capitoline Hill.",
      "confidence": 0.966
    }
  ],
